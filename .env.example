APP_NAME=CMS-TRS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Performance Optimization Settings
# Adjust these based on your environment (production vs development)

# Cache TTLs (in seconds)
# Production: Use longer TTLs for better performance
# Development: Use shorter TTLs to see changes immediately
CACHE_CRITICAL_SETTINGS_TTL=  # Default: 86400 (24h) in production, 300 (5min) in dev
CACHE_SETTINGS_TTL=  # Default: 3600 (1h) in production, 300 (5min) in dev
CACHE_MENU_TTL=  # Default: 3600 (1h) in production, 300 (5min) in dev
CACHE_MAINTENANCE_TTL=  # Default: 300 (5min) in production, 60 (1min) in dev

# Queue Settings
# Enable queueing for heavy operations in production
# Disable in development for easier debugging
QUEUE_MEDIA_CONVERSIONS=  # Default: true in production, false in dev
QUEUE_EMAIL_NOTIFICATIONS=  # Default: true in production, false in dev
QUEUE_BULK_OPERATIONS=  # Default: true in production, false in dev

# Database Query Logging
# Enable query logging in development for debugging
LOG_QUERIES=  # Default: true in local, false in production
SLOW_QUERY_THRESHOLD=1000  # Log queries slower than this (in milliseconds)

# Asset Optimization
# Enable asset minification and optimization in production
MINIFY_ASSETS=  # Default: true in production, false in dev
DROP_CONSOLE=  # Default: true in production, false in dev (removes console.log)
SOURCE_MAPS=  # Default: false in production, true in dev

# Debug Settings
# Show performance debugging information in development
SHOW_CACHE_STATS=  # Default: true in local, false in production
ENABLE_PROFILING=  # Default: true in local, false in production
